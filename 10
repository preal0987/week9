clear; clc;
x = -6:0.1:6;
y = -6:0.1:6;
[X, Y] = meshgrid(x, y);
Z = cos(X).*sin(Y).*exp(-0.05*(X.^2 + Y.^2));
figure
mesh(X, Y, Z)
title('Mesh graph')
xlabel('x')
ylabel('y')
zlabel('z')
grid on
figure
contour(X, Y, Z)
title('Contour graph')
xlabel('x')
ylabel('y')
grid on
[maxZ, idx] = max(Z(:));
x_max = X(idx);
y_max = Y(idx);
fprintf('z의 최대값 = %.4f\n', maxZ)
fprintf('최대값 위치: x = %.2f, y = %.2f\n', x_max, y_max)
